{
  "global": {
    "color": {
      "ink":              { "$value": "#1D1D1F", "$type": "color" },
      "muted":            { "$value": "rgba(60,60,67,0.6)", "$type": "color" },
      "bg":               { "$value": "#F5F5F7", "$type": "color" },
      "surface":          { "$value": "#FFFFFF", "$type": "color" },
      "accent":           { "$value": "#0A84FF", "$type": "color" },
      "accent-pressed":   { "$value": "#0060DF", "$type": "color" },
      "accent-contrast":  { "$value": "#FFFFFF", "$type": "color" },
      "error":            { "$value": "#FF453A", "$type": "color" },
      "success":          { "$value": "#30D158", "$type": "color" },
      "warning":          { "$value": "#FFD60A", "$type": "color" },
      "glass":            { "$value": "rgba(255,255,255,0.55)", "$type": "color" },
      "glass-strong":     { "$value": "rgba(255,255,255,0.72)", "$type": "color" },
      "glass-thin":       { "$value": "rgba(255,255,255,0.40)", "$type": "color" },
      "hairline":         { "$value": "rgba(255,255,255,0.35)", "$type": "color" },
      "specular":         { "$value": "rgba(255,255,255,0.6)", "$type": "color" }
    },
    "shadow": {
      "color":       { "$value": "rgba(0,0,0,0.12)", "$type": "color" },
      "inset-color": { "$value": "rgba(255,255,255,0.6)", "$type": "color" }
    },
    "duration": {
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" }
    },
    "easing": {
      "spring":   { "$value": "cubic-bezier(0.32, 0.72, 0, 1)" },
      "standard": { "$value": "ease" }
    },
    "blur": {
      "sm":     { "$value": "8px" },
      "base":   { "$value": "20px" },
      "strong": { "$value": "40px" }
    }
  },
  "alias": {
    "shadow": {
      "0":        { "$value": "0 2px 8px rgba(0,0,0,0.08)" },
      "1":        { "$value": "0 8px 32px rgba(0,0,0,0.12)" },
      "2":        { "$value": "0 16px 48px rgba(0,0,0,0.18)" },
      "3":        { "$value": "0 24px 64px rgba(0,0,0,0.24)" },
      "inset":    { "$value": "inset 0 1px 0 rgba(255,255,255,0.6)" },
      "specular": { "$value": "inset 0 1px 0 rgba(255,255,255,0.6)" },
      "accent":   { "$value": "0 0 0 4px rgba(10,132,255,0.35)" },
      "error":    { "$value": "0 0 0 4px rgba(255,69,58,0.30)" }
    },
    "vibrancy": {
      "sm":     { "$value": "blur(8px) saturate(160%)" },
      "base":   { "$value": "blur(20px) saturate(180%)" },
      "strong": { "$value": "blur(40px) saturate(200%)" }
    },
    "transition": {
      "snappy": { "$value": "{global.duration.fast} {global.easing.spring}" },
      "smooth": { "$value": "{global.duration.base} {global.easing.spring}" },
      "fast":   { "$value": "{global.duration.fast} {global.easing.spring}" },
      "base":   { "$value": "{global.duration.base} {global.easing.spring}" }
    },
    "radius": {
      "xs":      { "$value": "6px" },
      "sm":      { "$value": "10px" },
      "md":      { "$value": "16px" },
      "lg":      { "$value": "24px" },
      "full":    { "$value": "999px" },
      "default": { "$value": "16px" }
    },
    "surface": {
      "bg":           { "$value": "{global.color.glass}" },
      "bg-strong":    { "$value": "{global.color.glass-strong}" },
      "bg-alt":       { "$value": "{global.color.glass-thin}" },
      "border":       { "$value": "{global.color.hairline}" },
      "border-width": { "$value": "1px" },
      "padding":      { "$value": "24px" },
      "radius":       { "$value": "{alias.radius.md}" }
    },
    "text": {
      "main":  { "$value": "{global.color.ink}" },
      "muted": { "$value": "{global.color.muted}" }
    },
    "font": {
      "technical": { "$value": "'SF Mono', ui-monospace, 'JetBrains Mono', monospace" },
      "ui":        { "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', Inter, system-ui, sans-serif" }
    },
    "font-size": {
      "label":    { "$value": "11px" },
      "footnote": { "$value": "13px" },
      "btn":      { "$value": "14px" },
      "btn-sm":   { "$value": "12px" }
    },
    "font-weight": {
      "medium": { "$value": "510" },
      "bold":   { "$value": "600" }
    },
    "tracking": {
      "wide": { "$value": "0.02em" }
    },
    "space": {
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },
    "action": {
      "bg":               { "$value": "{global.color.glass-strong}" },
      "bg-primary":       { "$value": "{global.color.accent}" },
      "bg-pressed":       { "$value": "{global.color.accent-pressed}" },
      "color":            { "$value": "{global.color.ink}" },
      "color-primary":    { "$value": "{global.color.accent-contrast}" },
      "border":           { "$value": "{global.color.hairline}" },
      "shadow-primary":   { "$value": "{alias.shadow.1}" },
      "disabled-opacity": { "$value": "0.4" },
      "radius":           { "$value": "{alias.radius.full}" },
      "sheen":            { "$value": "linear-gradient(180deg, rgba(255,255,255,0.25), rgba(255,255,255,0) 55%)" },
      "padding-x":        { "$value": "20px" },
      "padding-y":        { "$value": "11px" },
      "padding-x-sm":     { "$value": "14px" },
      "padding-y-sm":     { "$value": "7px" }
    },
    "input": {
      "padding": { "$value": "10px" },
      "radius":  { "$value": "{alias.radius.sm}" }
    },
    "status": {
      "error":   { "$value": "{global.color.error}" },
      "success": { "$value": "{global.color.success}" },
      "warning": { "$value": "{global.color.warning}" }
    }
  },
  "aliasDark": {
    "surface": {
      "bg":        { "$value": "rgba(30,30,32,0.60)" },
      "bg-strong": { "$value": "rgba(40,40,44,0.72)" },
      "bg-alt":    { "$value": "rgba(30,30,32,0.45)" },
      "border":    { "$value": "rgba(255,255,255,0.15)" }
    },
    "text": {
      "main":  { "$value": "#F5F5F7" },
      "muted": { "$value": "rgba(235,235,245,0.6)" }
    },
    "shadow": {
      "inset":    { "$value": "inset 0 1px 0 rgba(255,255,255,0.12)" },
      "specular": { "$value": "inset 0 1px 0 rgba(255,255,255,0.12)" },
      "1":        { "$value": "0 8px 32px rgba(0,0,0,0.44)" },
      "2":        { "$value": "0 16px 48px rgba(0,0,0,0.52)" }
    },
    "action": {
      "bg":               { "$value": "rgba(60,60,64,0.60)" },
      "color":            { "$value": "#F5F5F7" },
      "border":           { "$value": "rgba(255,255,255,0.15)" },
      "shadow-primary":   { "$value": "0 8px 32px rgba(0,0,0,0.5)" },
      "disabled-opacity": { "$value": "0.4" }
    }
  }
}
