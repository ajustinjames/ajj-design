{
  "name": "ajj-design",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "tokens:build": "pnpm --filter @ajustinjames/hardline-tokens build",
    "prestorybook": "pnpm tokens:build",
    "prebuild-storybook": "pnpm tokens:build",
    "test": "pnpm --filter @ajustinjames/hardline-components test",
    "test:screenshots": "playwright test --config packages/hardline-components/playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/web-components": "^10.3.5",
    "@storybook/web-components-vite": "^10.0.0",
    "storybook": "^10.0.0",
    "typescript": "^5.4.0"
  }
}
